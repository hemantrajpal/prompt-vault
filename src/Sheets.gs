function getVaultV2() {return rpc_(function(actor){return withVaultLock_(function(){const config=settings_(),h=readCommittedHeads_();return {vaultRevision:h.vaultRevision,prompts:h.prompts,categories:h.categories,settings:{installId:config.installId,schemaVersion:2,ownerEmail:actor.email,aiEnabled:false,imagesEnabled:false},pendingOperation:operationSummary_(pendingOperation_())};});});}
