 });});});}
function getPromptHistoryV2(args) {return rpc_(function(){return withVaultLock_(function(){settings_();return readCommittedHeads_().revisions.filter(function(e){return e.type==='prompt'&&e.record.id===args.id;}).map(function(e){return e.record;}).reverse();});});}
